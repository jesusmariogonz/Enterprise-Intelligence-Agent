# Copia este archivo a .env y completa los valores reales.
# Nunca subas tu archivo .env real al repositorio.

# Clave de la API de Anthropic (Claude)
ANTHROPIC_API_KEY=

# Clave de la API de Voyage AI (embeddings, requerida desde el Capítulo 5)
VOYAGE_API_KEY=

# Ruta a la base de datos estructurada (Northwind) usada por EIA
EIA_DB_PATH=data/structured/northwind.db

# Ruta al corpus de documentos usado para RAG
EIA_DOCS_PATH=data/documents
